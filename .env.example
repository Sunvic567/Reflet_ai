# Local Google-auth server configuration. Copy to .env and replace placeholders.
# Real .env files are ignored by Git. Enter production values in Render's dashboard.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
REFLECT_BASE_URL=http://localhost:3000
REFLECT_ALLOWED_EMAILS=you@gmail.com
REFLECT_OWNER_EMAIL=you@gmail.com
PORT=3000
